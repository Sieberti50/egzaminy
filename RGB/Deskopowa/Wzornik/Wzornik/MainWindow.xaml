<Window x:Class="Wzornik.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wzornik kolorów RGB. Wykonał Filip Siebert"
        Height="450" Width="800"
        Background="#FFF8DC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="60" />
        </Grid.ColumnDefinitions>

        <Rectangle x:Name="bigRectangle" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                   Fill="White" Margin="0,0,0,10" />

        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                   Text="Dobierz kolor suwakami i zapisz przyciskiem:"
                   VerticalAlignment="Center" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="R" VerticalAlignment="Center" />
        <Slider x:Name="sliderRed" Grid.Row="2" Grid.Column="1"
                Minimum="0" Maximum="255" Value="255"
                TickFrequency="1" IsSnapToTickEnabled="True"
                VerticalAlignment="Center" ValueChanged="Slider_ValueChanged" />
        <TextBlock x:Name="labelRed" Grid.Row="2" Grid.Column="2" Text="255"
                   VerticalAlignment="Center" HorizontalAlignment="Center" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="G" VerticalAlignment="Center" />
        <Slider x:Name="sliderGreen" Grid.Row="3" Grid.Column="1"
                Minimum="0" Maximum="255" Value="255"
                TickFrequency="1" IsSnapToTickEnabled="True"
                VerticalAlignment="Center" ValueChanged="Slider_ValueChanged" />
        <TextBlock x:Name="labelGreen" Grid.Row="3" Grid.Column="2" Text="255"
                   VerticalAlignment="Center" HorizontalAlignment="Center" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="B" VerticalAlignment="Center" />
        <Slider x:Name="sliderBlue" Grid.Row="4" Grid.Column="1"
                Minimum="0" Maximum="255" Value="255"
                TickFrequency="1" IsSnapToTickEnabled="True"
                VerticalAlignment="Center" ValueChanged="Slider_ValueChanged" />
        <TextBlock x:Name="labelBlue" Grid.Row="4" Grid.Column="2" Text="255"
                   VerticalAlignment="Center" HorizontalAlignment="Center" />

        <Button x:Name="buttonTake" Grid.Row="5" Grid.Column="1"
                Content="Pobierz" Background="#CD853F"
                Width="200" Height="30" HorizontalAlignment="Center"
                Click="buttonTake_Click" />

        <Label x:Name="labelTaken" Grid.Row="6" Grid.Column="1"
               Content="255, 255, 255" Background="White"
               Width="200" Height="30" HorizontalAlignment="Center" />
    </Grid>
</Window>