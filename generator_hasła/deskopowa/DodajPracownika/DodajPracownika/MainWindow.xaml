<Window x:Class="DodajPracownika.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodaj pracownika - Filip Siebert"
        Height="330" Width="640"
        Background="#B0C4DE"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#4682B4"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="Dane pracownika" Grid.Row="0" Grid.Column="0" Margin="20,20,10,10">
            <Grid>
                <Label Content="Imię" HorizontalAlignment="Left" Margin="20,15,0,0" VerticalAlignment="Top"/>
                <TextBox x:Name="ImieTextBox" Width="130" Height="24" HorizontalAlignment="Left" Margin="120,17,0,0" VerticalAlignment="Top"/>

                <Label Content="Nazwisko" HorizontalAlignment="Left" Margin="20,60,0,0" VerticalAlignment="Top"/>
                <TextBox x:Name="NazwiskoTextBox" Width="130" Height="24" HorizontalAlignment="Left" Margin="120,62,0,0" VerticalAlignment="Top"/>

                <Label Content="Stanowisko" HorizontalAlignment="Left" Margin="20,105,0,0" VerticalAlignment="Top"/>
                <ComboBox x:Name="StanowiskoComboBox" Width="130" Height="24" HorizontalAlignment="Left" Margin="120,107,0,0" VerticalAlignment="Top"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="Generowanie hasła" Grid.Row="0" Grid.Column="1" Margin="10,20,20,10">
            <Grid>
                <Label Content="Ile znaków?" HorizontalAlignment="Left" Margin="20,15,0,0" VerticalAlignment="Top"/>
                <TextBox x:Name="IleZnakowTextBox" Width="110" Height="24" HorizontalAlignment="Left" Margin="120,17,0,0" VerticalAlignment="Top"/>

                <CheckBox x:Name="LiteryCheckBox" Content="Małe i wielkie litery" IsChecked="True" HorizontalAlignment="Left" Margin="30,60,0,0" VerticalAlignment="Top"/>
                <CheckBox x:Name="CyfryCheckBox" Content="Cyfry" HorizontalAlignment="Left" Margin="30,88,0,0" VerticalAlignment="Top"/>
                <CheckBox x:Name="ZnakiSpecjalneCheckBox" Content="Znaki specjalne" HorizontalAlignment="Left" Margin="30,116,0,0" VerticalAlignment="Top"/>

                <Button x:Name="GenerujHasloButton" Content="Generuj hasło" Width="90" Height="24" HorizontalAlignment="Left" Margin="90,150,0,0" VerticalAlignment="Top" Click="GenerujHasloButton_Click"/>
            </Grid>
        </GroupBox>

        <Button x:Name="ZatwierdzButton" Content="Zatwierdź" Grid.Row="1" Grid.ColumnSpan="2" Height="26" Margin="100,0,100,20" Click="ZatwierdzButton_Click"/>
    </Grid>
</Window>