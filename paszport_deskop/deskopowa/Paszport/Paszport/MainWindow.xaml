<Window x:Class="Paszport.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wprowadzenie danych do paszportu. Wykonał: Filip Siebert"
        Height="400" Width="780" Background="#5F9EA0">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="49*"/>
            <ColumnDefinition Width="731*"/>
        </Grid.ColumnDefinitions>
        <Label Content="Numer" Margin="30,30,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.ColumnSpan="2"/>
        <TextBox x:Name="txtNumer" Margin="61,32,0,0" Width="220" Height="22"
                 HorizontalAlignment="Left" VerticalAlignment="Top" Background="#F0FFFF"
                 LostFocus="txtNumer_LostFocus" Grid.Column="1"/>

        <Label Content="Imię" Margin="30,65,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.ColumnSpan="2"/>
        <TextBox x:Name="txtImie" Margin="61,67,0,0" Width="220" Height="22"
                 HorizontalAlignment="Left" VerticalAlignment="Top" Background="#F0FFFF" Grid.Column="1"/>

        <Label Content="Nazwisko" Margin="30,100,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.ColumnSpan="2"/>
        <TextBox x:Name="txtNazwisko" Margin="61,102,0,0" Width="220" Height="22"
                 HorizontalAlignment="Left" VerticalAlignment="Top" Background="#F0FFFF" Grid.Column="1"/>

        <GroupBox Header="Kolor oczu" Margin="20,150,0,0" Width="320" Height="130"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Grid.ColumnSpan="2">
            <StackPanel Margin="10,5,0,0">
                <RadioButton x:Name="rbNiebieskie" Content="niebieskie" IsChecked="True" Margin="0,5,0,5"/>
                <RadioButton x:Name="rbZielone" Content="zielone" Margin="0,5,0,5"/>
                <RadioButton x:Name="rbPiwne" Content="piwne" Margin="0,5,0,5"/>
            </StackPanel>
        </GroupBox>

        <Image x:Name="imgZdjecie" Height="180" Margin="311,20,0,0"
               HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Column="1"/>
        <Image x:Name="imgOdcisk" Height="180" Margin="491,20,0,0"
               HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Column="1"/>

        <Button x:Name="btnOk" Content="OK" Width="300" Height="30" Margin="311,240,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Top" Background="#F0FFFF"
                Click="btnOk_Click" Grid.Column="1"/>
    </Grid>
</Window>